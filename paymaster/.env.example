# ─── TONPaymaster deployment config ──────────────────────────────────────────
# Copy to `paymaster/.env` and fill in. NEVER commit a real PRIVATE_KEY.
# Used by the deterministic CREATE3 deploy scripts and their fork tests.

# Deployer EOA private key (also becomes the paymaster owner)
PRIVATE_KEY=

# RPC URLs (broadcasts + deterministic fork tests)
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=

# Etherscan key for `--verify`
ETHERSCAN_API_KEY=

# EntryPoint
ENTRY_POINT_V07=0x0000000071727De22E5E9d8BAf0edAc6f37da032
ENTRY_POINT_V08=0x4337084D9E255Ff0702461CF8895CE9E3b5Ff108

# TON token
SEPOLIA_TON_TOKEN=0xa30fe40285B8f5c0457DbC3B7C8A280373c40044
MAINNET_TON_TOKEN=0x2be5e8c109e2197D077D13A82dAead6a9b3433C5

# Mainnet oracle (Uniswap V3 WTON/WETH, 0.3% fee tier)
MAINNET_WTON_TOKEN=0xc4A11aaf6ea915Ed7Ac194161d2fC9384F15bff2
MAINNET_WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
MAINNET_WTON_WETH_POOL=0xC29271E3a68A7647Fd1399298Ef18FeCA3879F59
TWAP_PERIOD=1800

# Fallback pricing (TON per ETH, 18 decimals) used until the oracle is enabled
DEFAULT_TOKEN_PER_ETH=2500000000000000000000

# Price markup in bps (>= 10000). Mainnet default 10500 = 5%
MARKUP_BPS=10500

# Deterministic deployment — canonical CreateX factory (same on mainnet + sepolia)
CREATEX_FACTORY=0xba5Ed099633D3B313e4D5F7bdc1305d3c28ba5Ed
# Bump SALT_ENTROPY to intentionally deploy a NEW deterministic address.
SALT_ENTROPY=TONPaymaster-V1

# NOTE: the scripts use fixed EntryPoint amounts — stake 0.01 ETH, deposit
# 0.05 ETH (mainnet) / 0.1 ETH (sepolia). Edit the scripts to change them.
