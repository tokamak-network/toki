# Network: "sepolia" for testnet, omit or "mainnet" for production
NEXT_PUBLIC_NETWORK=sepolia

# Ethereum RPC URL (Alchemy or Infura)
NEXT_PUBLIC_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Privy App ID (https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=

# Pimlico Bundler API Key (https://dashboard.pimlico.io)
NEXT_PUBLIC_PIMLICO_API_KEY=

# TON Paymaster contract address (after deployment)
NEXT_PUBLIC_TON_PAYMASTER_ADDRESS=

# Site URL for SEO (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://toki.tokamak.network

# TON AI Access — native in-app key issuance (Arch B).
# The AI Access service domain auto-follows NEXT_PUBLIC_NETWORK (no URL to set):
#   mainnet → https://tokamak-ai-access.vercel.app
#   sepolia → https://tokamak-ai-access-git-sepolia-theo-3096s-projects.vercel.app
# Set this to 1 to issue keys natively in-app (one click → SIWE sign → key set).
# Enable only once the matching deploy's /api/keys/issue-delegated is live and
# lists this app's origin in DELEGATED_ALLOWED_ORIGINS. Unset/0 = external handoff.
NEXT_PUBLIC_AI_ACCESS_NATIVE=

# Agent Workspace proxy (/api/agent) — Tokamak AI server the issued key talks to.
# Both optional; defaults shown. See docs/ai-agent-workspace.md.
AI_ACCESS_LLM_URL=https://api2.ai.tokamak.network
AI_ACCESS_MODEL=qwen-3.6

# Stage 2 — server-side encrypted key vault (key never lives in the browser).
# Required for /agent chat + key storage once Stage 2 is on. Without these the
# AI endpoints return 503 "not configured".
#   PRIVY_APP_SECRET : Privy dashboard → app → API keys (server secret). Verifies
#                      the Privy access token server-side (all login methods).
#   AI_KEY_ENC_SECRET: 32-byte AES-256-GCM key for at-rest encryption.
#                      Generate: openssl rand -hex 32   (64 hex chars)
# Also apply supabase/migrations/20260619000000_ai_access_keys.sql.
PRIVY_APP_SECRET=
AI_KEY_ENC_SECRET=

# Supabase (used by lottery + analytics). The service-role key is server-only —
# NEVER expose it to the client. See src/lib/supabase.ts / supabase-admin.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Analytics dashboard gate. Set to any long random string; required to open
# /admin/analytics and call /api/admin/analytics. See docs/analytics-tool.md.
ADMIN_DASHBOARD_TOKEN=

# External analytics (optional, loaded in app/layout.tsx only when set).
# Google Analytics 4 measurement ID — also receives forwarded product events
# (wallet_created, stake, ...) from track(). Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID — session replays + heatmaps (free).
NEXT_PUBLIC_CLARITY_ID=
